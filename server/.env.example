# Copy this file to ".env" and fill in your own values.

# Prisma reads this one - it is the whole database connection in a single line:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://booking:booking@127.0.0.1:5432/booking?schema=public"

# Used to sign the login tokens
JWT_SECRET="change-me-to-something-random"

PORT=8000
